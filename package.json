{
  "name": "kestro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:model": "node scripts/build-model.mjs && node scripts/render-hero-still.mjs",
    "build:team-photos": "node scripts/build-team-photos.mjs",
    "build:artwork": "node scripts/build-artwork.mjs",
    "build:assembly": "node scripts/render-laptop-assembly.mjs",
    "build:cards": "node scripts/build-artwork.mjs cards && node scripts/build/check-cards.mjs",
    "verify": "node scripts/verify/run.mjs",
    "security": "node scripts/security/attack.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.33.0",
    "next": "^15.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.7"
  }
}
